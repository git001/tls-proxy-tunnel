vtest "tls-proxy-tunnel: tcp6:// upstream uses IPv6-only resolution"

# tpt connects to the backend using tcp6://, which forces IPv6-only address
# resolution in UpstreamAddress::resolve().
# Covers: upstream_address.rs lines 93-96 (ResolutionMode::Ipv6 filter).

# Echo backend listening on [::1] only (IPV6_V6ONLY)
process pbackend "python3 ${testdir}/helpers/echo_server_v6.py 25835" -start

shell {
    for i in $(seq 1 50); do
        nc -z ::1 25835 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: IPv6 backend did not start on [::1]:25835 in time" >&2
    exit 1
}

shell {
    cat > ${tmpdir}/tpt.yaml <<'EOF'
version: 2
log: disable
servers:
  tcp6_relay_server:
    listen:
      - "127.0.0.1:25834"
    default: backend6
    maxclients: 10
upstream:
  backend6: "tcp6://[::1]:25835"
EOF
}

process ptpt "env TPT_CONFIG=${tmpdir}/tpt.yaml ${tpt}" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25834 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: tpt did not listen on 25834 in time" >&2
    exit 1
}

shell {
    python3 ${testdir}/helpers/echo_roundtrip.py 25834 "ipv6 relay works"
}

process ptpt -kill TERM
process ptpt -wait
process pbackend -kill TERM
process pbackend -wait
