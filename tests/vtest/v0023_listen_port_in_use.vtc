vtest "tls-proxy-tunnel: a listen port already in use ends tpt with exit 1"

# Port 25856 is held by another process. tpt must not run on with only its
# other listener (25857): it shuts down and exits 1, so systemd/OpenShift
# see the failure.

shell {
    cat > ${tmpdir}/tpt.yaml <<'EOF'
version: 1
log: info
servers:
  busy:
    listen:
      - "127.0.0.1:25856"
    default: echo
  health_server:
    listen:
      - "127.0.0.1:25857"
    default: health
upstream: {}
EOF
    python3 -c '
import socket, time
s = socket.socket()
s.bind(("127.0.0.1", 25856))
s.listen(1)
open("'${tmpdir}'/held", "w").close()
time.sleep(30)
' &
    holder=$!
    for i in $(seq 1 50); do
        test -f ${tmpdir}/held && break
        sleep 0.1
    done

    rc=0
    timeout 10 ${tpt} --config ${tmpdir}/tpt.yaml 2> ${tmpdir}/tpt.err || rc=$?
    kill $holder 2>/dev/null
    cat ${tmpdir}/tpt.err >&2
    test $rc -eq 1 || { echo "exit $rc, want 1 (124 = still running)" >&2; exit 1; }
    grep -q "Server busy on 127.0.0.1:25856 failed" ${tmpdir}/tpt.err \
        || { echo "no failure in the log" >&2; exit 1; }
}
