vtest "tls-proxy-tunnel: use_sni_as_target derives CONNECT target from TLS SNI"

# This test uses the same TLS ClientHello bytes as the unit test in tls.rs.
# SNI in that record is "www.lirui.tech".
# With use_sni_as_target=true and target_port=8443, tpt must send:
#   CONNECT www.lirui.tech:8443 HTTP/1.1
# to the upstream proxy, then forward the original ClientHello bytes through.

# The backend checks the CONNECT target (502 + exit 1 on mismatch), answers
# 200 and echoes everything that follows (the ClientHello).
process pbackend "python3 ${testdir}/helpers/connect_backend.py 25811 --expect-target www.lirui.tech:8443" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25811 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: backend did not start on 25811 in time" >&2
    exit 1
}

shell {
    cat > ${tmpdir}/tpt.yaml <<'EOF'
version: 2
log: disable
servers:
  sni_proxy:
    listen:
      - "127.0.0.1:25805"
    tls: true
    default: corp_proxy
    maxclients: 10
    via:
      use_sni_as_target: true
      target_port: 8443
      connect_timeout: 5s
upstream:
  corp_proxy: "tcp://127.0.0.1:25811"
EOF
}

process ptpt "env TPT_CONFIG=${tmpdir}/tpt.yaml ${tpt}" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25805 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: tpt did not listen on 25805 in time" >&2
    exit 1
}

# Send the exact TLS ClientHello from tls.rs (SNI "www.lirui.tech"); tpt
# peeks it for the SNI and forwards it unchanged, the backend echoes it.
shell {
    python3 ${testdir}/helpers/client_hello_echo.py 25805 10
}

process ptpt -kill TERM
process ptpt -wait
process pbackend -kill TERM
process pbackend -wait
