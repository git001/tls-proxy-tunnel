vtest "tls-proxy-tunnel: fragmented CONNECT response is accumulated correctly"

# The backend sends the HTTP CONNECT response split across three separate TCP
# segments to force tpt's read loop to accumulate bytes until \r\n\r\n:
#   segment 1: "HTTP/1.1 200 "
#   segment 2: "Connection Established\r\n"
#   segment 3: "\r\n"
#
# This covers the accumulation loop in http.rs that was added to handle
# split TCP packets. Without that loop tpt would call parse_connect_status()
# on incomplete input and either fail or mis-route the connection.

# --fragment: TCP_NODELAY and one send() per segment, 30ms apart; then echo
process pbackend "python3 ${testdir}/helpers/connect_backend.py 25842 --fragment" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25842 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: backend did not start on 25842 in time" >&2
    exit 1
}

shell {
    cat > ${tmpdir}/tpt.yaml <<'EOF'
version: 2
log: disable
servers:
  proxy_server:
    listen:
      - "127.0.0.1:25841"
    default: backend
    maxclients: 10
    via:
      target: "ext.example.com:443"
      connect_timeout: 5s
upstream:
  backend: "tcp://127.0.0.1:25842"
EOF
}

process ptpt "env TPT_CONFIG=${tmpdir}/tpt.yaml ${tpt}" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25841 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: tpt did not listen on 25841 in time" >&2
    exit 1
}

# Fragmented CONNECT response: verify the relay works end-to-end
shell {
    python3 ${testdir}/helpers/echo_roundtrip.py 25841 hello-fragmented-response
}

process ptpt -kill TERM
process ptpt -wait
process pbackend -kill TERM
process pbackend -wait
