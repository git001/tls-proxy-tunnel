vtest "tls-proxy-tunnel: proxy upstream tunnels via HTTP CONNECT"

# HTTP CONNECT backend: answers 200, then echoes
process pbackend "python3 ${testdir}/helpers/connect_backend.py 25810" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25810 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: backend did not start on 25810 in time" >&2
    exit 1
}

shell {
    cat > ${tmpdir}/tpt.yaml <<'EOF'
version: 2
log: disable
servers:
  proxy_server:
    listen:
      - "127.0.0.1:25804"
    default: backend
    maxclients: 10
    via:
      target: "ext.example.com:443"
      connect_timeout: 5s
upstream:
  backend: "tcp://127.0.0.1:25810"
EOF
}

process ptpt "env TPT_CONFIG=${tmpdir}/tpt.yaml ${tpt}" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25804 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: tpt did not listen on 25804 in time" >&2
    exit 1
}

shell {
    python3 ${testdir}/helpers/echo_roundtrip.py 25804 "ping from client"
}

process ptpt -kill TERM
process ptpt -wait
process pbackend -kill TERM
process pbackend -wait
