vtest "tls-proxy-tunnel: CONNECT with header env-var substitution"

# Backend verifies that the Proxy-Authorization header contains the resolved
# value of the env var, not the literal placeholder string (502 + exit 1 on
# mismatch), then answers 200 and echoes.
process pbackend "python3 ${testdir}/helpers/connect_backend.py 25823 --expect-header 'Proxy-Authorization: Basic testvalue123'" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25823 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: backend did not start on 25823 in time" >&2
    exit 1
}

shell {
    cat > ${tmpdir}/tpt.yaml <<'EOF'
version: 2
log: disable
servers:
  headers_server:
    listen:
      - "127.0.0.1:25822"
    default: backend
    maxclients: 10
    via:
      target: "ext.example.com:443"
      connect_timeout: 5s
      headers:
        Proxy-Authorization: "Basic $PROXY_TEST_TOKEN"
upstream:
  backend: "tcp://127.0.0.1:25823"
EOF
}

# Inject PROXY_TEST_TOKEN into the tpt process
process ptpt "env PROXY_TEST_TOKEN=testvalue123 TPT_CONFIG=${tmpdir}/tpt.yaml ${tpt}" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25822 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: tpt did not listen on 25822 in time" >&2
    exit 1
}

# Test 1: valid env var -> header resolved, tunnel works
shell {
    python3 ${testdir}/helpers/echo_roundtrip.py 25822 "header substitution works"
    grep -q "OK: header Proxy-Authorization correct" ${pbackend_out} || {
        echo "ERROR: backend did not confirm the Proxy-Authorization header" >&2
        cat ${pbackend_out} ${pbackend_err} >&2
        exit 1
    }
}

process ptpt -kill TERM
process ptpt -wait
process pbackend -kill TERM
process pbackend -wait

# -------------------------------------------------------------------------
# Test 2: missing env var -> resolve_header_value() returns Err
#         tpt must close the inbound connection instead of crashing.
# -------------------------------------------------------------------------
shell {
    cat > ${tmpdir}/tpt2.yaml <<'EOF'
version: 2
log: disable
servers:
  missing_var_server:
    listen:
      - "127.0.0.1:25822"
    default: backend
    maxclients: 10
    via:
      target: "ext.example.com:443"
      connect_timeout: 5s
      headers:
        Proxy-Authorization: "Basic $PROXY_VAR_THAT_DOES_NOT_EXIST"
upstream:
  backend: "tcp://127.0.0.1:25823"
EOF
}

process pbackend2 "python3 ${testdir}/helpers/connect_backend.py 25823 --expect-header 'Proxy-Authorization: Basic testvalue123'" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25823 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: backend2 did not start in time" >&2
    exit 1
}

# Start tpt WITHOUT setting PROXY_VAR_THAT_DOES_NOT_EXIST
process ptpt2 "env TPT_CONFIG=${tmpdir}/tpt2.yaml ${tpt}" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25822 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: tpt2 did not listen on 25822 in time" >&2
    exit 1
}

shell {
    python3 ${testdir}/helpers/expect_close.py 25822 0 5
}

process ptpt2 -kill TERM
process ptpt2 -wait
process pbackend2 -kill TERM
process pbackend2 -wait
