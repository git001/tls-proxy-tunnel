vtest "tls-proxy-tunnel: stats_interval periodic rx/tx logging"

# A relay with stats_interval: 100ms must fire the stats logger at least once
# during a connection that lasts ~400ms.
# Covers relay() lines: stats_interval > 0 branch, tokio::spawn, ticker,
# info!() call, and log_handle.abort() after relay completes.
# Log output is captured and checked for the "in-flight" stats line.

# Like a real proxy: read the CONNECT request, answer 200, then echo.
process pbackend "python3 ${testdir}/helpers/connect_backend.py 25825" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25825 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: backend did not start on 25825 in time" >&2
    exit 1
}

shell {
    cat > ${tmpdir}/tpt.yaml <<'EOF'
version: 2
log: info
servers:
  stats_server:
    listen:
      - "127.0.0.1:25824"
    default: backend
    maxclients: 10
    via:
      target: "ext.example.com:443"
      connect_timeout: 5s
      stats_interval: 100ms
upstream:
  backend: "tcp://127.0.0.1:25825"
EOF
}

process ptpt "env TPT_CONFIG=${tmpdir}/tpt.yaml ${tpt}" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25824 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: tpt did not listen on 25824 in time" >&2
    exit 1
}

# Hold the connection open for ~500ms (4 echoes, 120ms pause after each, so
# the 100ms stats logger fires at least 3 times), then close cleanly.
# Verifies the logger task is spawned, ticks, and is aborted after the relay
# completes without crashing tpt.
shell {
    python3 ${testdir}/helpers/echo_sequence.py 25824 --pause 0.12 chunk-0 chunk-1 chunk-2 chunk-3
}

# Verify that the stats logger actually fired: stderr must contain "in-flight"
shell {
    grep -q "in-flight" ${ptpt_err} || {
        echo "ERROR: stats_interval log line 'in-flight' not found in tpt output" >&2
        cat ${ptpt_err} >&2
        exit 1
    }
}

process ptpt -kill TERM
process ptpt -wait
process pbackend -kill TERM
process pbackend -wait
