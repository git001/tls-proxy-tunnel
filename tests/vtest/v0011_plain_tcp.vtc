vtest "tls-proxy-tunnel: non-TLS plain TCP relay without HTTP CONNECT"

# tpt forwards raw bytes directly to the upstream (no TLS SNI, no CONNECT).
# Covers: tcp.rs else-branch (snis = Vec::new()) and
#         proxy_to_upstream/mod.rs None branch (connect_target = None).

process pbackend "python3 ${testdir}/helpers/echo_server.py 25833" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25833 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: backend did not start on 25833 in time" >&2
    exit 1
}

shell {
    cat > ${tmpdir}/tpt.yaml <<'EOF'
version: 2
log: disable
servers:
  plain_tcp_server:
    listen:
      - "127.0.0.1:25832"
    default: backend
    maxclients: 10
upstream:
  backend: "tcp://127.0.0.1:25833"
EOF
}

process ptpt "env TPT_CONFIG=${tmpdir}/tpt.yaml ${tpt}" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25832 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: tpt did not listen on 25832 in time" >&2
    exit 1
}

shell {
    python3 ${testdir}/helpers/echo_sequence.py 25832 hello world hex:00010203
}

process ptpt -kill TERM
process ptpt -wait
process pbackend -kill TERM
process pbackend -wait
