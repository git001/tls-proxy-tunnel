vtest "tls-proxy-tunnel: upstream connection refused closes inbound"

# Port 25838 is intentionally never started: connection refused triggers
# an error in tpt which then closes the inbound connection.

shell {
    cat > ${tmpdir}/tpt.yaml <<'EOF'
version: 2
log: disable
servers:
  proxy_server:
    listen:
      - "127.0.0.1:25837"
    default: refused_upstream
    maxclients: 10
    via:
      connect_timeout: 2s
upstream:
  refused_upstream: "tcp://127.0.0.1:25838"
EOF
}

process ptpt "env TPT_CONFIG=${tmpdir}/tpt.yaml ${tpt}" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25837 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: tpt did not listen on 25837 in time" >&2
    exit 1
}

# tpt cannot reach the upstream, so it closes the inbound: recv returns EOF
shell {
    python3 ${testdir}/helpers/expect_close.py 25837 0 5
}

process ptpt -kill TERM
process ptpt -wait
