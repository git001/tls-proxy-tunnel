vtest "tls-proxy-tunnel: maxclients rejects connections beyond the limit"

# With maxclients: 1, the second concurrent connection must be rejected
# immediately (TCP RST / EOF) while the first one is still active.
# Covers tcp.rs: try_acquire_owned() Err branch (warn! + stream drop).

shell {
    cat > ${tmpdir}/tpt.yaml <<'EOF'
version: 2
log: disable
servers:
  limited_server:
    listen:
      - "127.0.0.1:25826"
    default: echo
    maxclients: 1
EOF
}

process ptpt "env TPT_CONFIG=${tmpdir}/tpt.yaml ${tpt}" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25826 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: tpt did not listen on 25826 in time" >&2
    exit 1
}

# Client 1: sends a byte, expects the echo, then holds the slot for 2 seconds.
# Uses the echo upstream: as long as client 1 does not close, the permit is held.
process pclient1 "python3 ${testdir}/helpers/occupy_slot.py 25826 X 2 --expect-echo" -start

# Give client 1 time to connect and acquire the permit
shell { sleep 0.3 }

# Client 2: must be rejected immediately; tpt drops the stream on try_acquire_owned() failure
shell {
    python3 ${testdir}/helpers/expect_close.py 25826 0 3
}

process pclient1 -wait

process ptpt -kill TERM
process ptpt -wait
