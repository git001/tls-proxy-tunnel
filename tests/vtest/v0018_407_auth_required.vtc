vtest "tls-proxy-tunnel: 407 Proxy Authentication Required closes connection without crashing"

# Backend returns 407 (with a Proxy-Authenticate header) for every connection.
# tpt must close the inbound connection and continue running, not crash.
# A second connection afterwards verifies tpt is still alive.
# Covers http.rs: the "other" match arm (status not in 200-299/403/502/503).

process pbackend "python3 ${testdir}/helpers/connect_backend.py 25846 --status 407" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25846 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: backend did not start on 25846 in time" >&2
    exit 1
}

shell {
    cat > ${tmpdir}/tpt.yaml <<'EOF'
version: 2
log: disable
servers:
  proxy_server:
    listen:
      - "127.0.0.1:25845"
    default: backend
    maxclients: 10
    via:
      target: "ext.example.com:443"
      connect_timeout: 5s
upstream:
  backend: "tcp://127.0.0.1:25846"
EOF
}

process ptpt "env TPT_CONFIG=${tmpdir}/tpt.yaml ${tpt}" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25845 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: tpt did not listen on 25845 in time" >&2
    exit 1
}

# Connection 1: backend returns 407, tpt must close inbound (EOF or RST)
shell {
    python3 ${testdir}/helpers/send_expect_close.py 25845 hello
}

# Connection 2: tpt must still be running after the 407
shell {
    nc -z 127.0.0.1 25845 || {
        echo "ERROR: tpt not reachable after 407" >&2
        exit 1
    }
}

process ptpt -kill TERM
process ptpt -wait
process pbackend -kill TERM
process pbackend -wait
