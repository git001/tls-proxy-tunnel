vtest "tls-proxy-tunnel: health server responds even when proxy maxclients is exhausted"

# The proxy server has maxclients: 1. One persistent connection fills the slot.
# A second proxy connection must be rejected (EOF).
# The health server runs on a separate port with its own listener: it has no
# maxclients limit and must return 200 OK regardless of proxy saturation.
#
# Covers: health server independence from proxy semaphore.

# CONNECT backend: answers 200, then reads and discards until the client closes
process pbackend "python3 ${testdir}/helpers/connect_backend.py 25852 --after drain" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25852 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: blocking_backend did not start on 25852 in time" >&2
    exit 1
}

shell {
    cat > ${tmpdir}/tpt.yaml <<'EOF'
version: 2
log: disable
servers:
  proxy_server:
    listen:
      - "127.0.0.1:25850"
    default: backend
    maxclients: 1
    via:
      target: "ext.example.com:443"
      connect_timeout: 5s
  health_server:
    listen:
      - "127.0.0.1:25851"
    default: health
upstream:
  backend: "tcp://127.0.0.1:25852"
EOF
}

process ptpt "env TPT_CONFIG=${tmpdir}/tpt.yaml ${tpt}" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25850 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: tpt did not listen on 25850 in time" >&2
    exit 1
}

# Start holding client: fills the single maxclients slot for 3 seconds
process phold "python3 ${testdir}/helpers/occupy_slot.py 25850 hello 3 --ready ${tmpdir}/hold_ready" -start

shell {
    for i in $(seq 1 50); do
        test -f ${tmpdir}/hold_ready 2>/dev/null && exit 0
        sleep 0.1
    done
    echo "ERROR: hold_client did not connect in time" >&2
    exit 1
}

# Second proxy connection must be rejected because maxclients: 1 is full
shell {
    python3 ${testdir}/helpers/expect_close.py 25850 0 5
}

# Health check must succeed even though the proxy is at maxclients
client c1 -connect 127.0.0.1:25851 {
    txreq -url /health
    rxresp
    expect resp.status == 200
}

client c1 -run

process phold -kill TERM
process phold -wait
process ptpt -kill TERM
process ptpt -wait
process pbackend -kill TERM
process pbackend -wait
