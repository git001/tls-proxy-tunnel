vtest "tls-proxy-tunnel: echo upstream reflects bytes back"

shell {
    cat > ${tmpdir}/tpt.yaml <<'EOF'
version: 2
log: disable
servers:
  echo_server:
    listen:
      - "127.0.0.1:25802"
    default: echo
    maxclients: 10
upstream: {}
EOF
}

process ptpt "env TPT_CONFIG=${tmpdir}/tpt.yaml ${tpt}" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25802 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: tpt did not listen on 25802 in time" >&2
    exit 1
}

shell {
    python3 ${testdir}/helpers/echo_sequence.py 25802 hello world hex:00010203
}

process ptpt -kill TERM
process ptpt -wait
