vtest "tls-proxy-tunnel: TLS SNI not in map falls back to default upstream"

# The sni: map contains only "other.example.com".
# The ClientHello carries SNI = www.lirui.tech (not in the map).
# tpt must fall back to the default upstream (corp_proxy) and the tunnel
# must work end-to-end (echo backend returns the ClientHello bytes).

# CONNECT backend: answers 200, then echoes
process pbackend "python3 ${testdir}/helpers/connect_backend.py 25840" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25840 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: backend did not start on 25840 in time" >&2
    exit 1
}

shell {
    cat > ${tmpdir}/tpt.yaml <<'EOF'
version: 2
log: disable
servers:
  sni_fallback_server:
    listen:
      - "127.0.0.1:25839"
    tls: true
    sni:
      other.example.com: corp_proxy
    default: corp_proxy
    via:
      use_sni_as_target: true
      target_port: 443
      connect_timeout: 5s
upstream:
  corp_proxy: "tcp://127.0.0.1:25840"
EOF
}

process ptpt "env TPT_CONFIG=${tmpdir}/tpt.yaml ${tpt}" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25839 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: tpt did not listen on 25839 in time" >&2
    exit 1
}

# Send ClientHello with SNI = www.lirui.tech (not in sni map).
# tpt falls back to corp_proxy, sends CONNECT www.lirui.tech:443,
# backend replies 200 and echoes the ClientHello back.
shell {
    python3 ${testdir}/helpers/client_hello_echo.py 25839 10
}

process ptpt -kill TERM
process ptpt -wait
process pbackend -kill TERM
process pbackend -wait
