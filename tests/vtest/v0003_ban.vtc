vtest "tls-proxy-tunnel: ban upstream closes connection immediately"

shell {
    cat > ${tmpdir}/tpt.yaml <<'EOF'
version: 2
log: disable
servers:
  ban_server:
    listen:
      - "127.0.0.1:25803"
    default: ban
    maxclients: 10
upstream: {}
EOF
}

process ptpt "env TPT_CONFIG=${tmpdir}/tpt.yaml ${tpt}" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25803 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: tpt did not listen on 25803 in time" >&2
    exit 1
}

# Ban upstream must shut the connection down immediately: recv returns EOF.
shell {
    python3 ${testdir}/helpers/expect_close.py 25803 0 5
}

process ptpt -kill TERM
process ptpt -wait
