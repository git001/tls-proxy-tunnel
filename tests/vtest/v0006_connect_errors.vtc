vtest "tls-proxy-tunnel: HTTP CONNECT error responses (403 502 503 other)"

# Backend cycles through 4 error responses for successive connections.
# tpt must close the inbound connection for each error and continue running.
process pbackend "python3 ${testdir}/helpers/connect_backend.py 25821 --status 403,502,503,418" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25821 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: backend did not start on 25821 in time" >&2
    exit 1
}

shell {
    cat > ${tmpdir}/tpt.yaml <<'EOF'
version: 2
log: disable
servers:
  error_server:
    listen:
      - "127.0.0.1:25820"
    default: backend
    maxclients: 10
    via:
      target: "ext.example.com:443"
      connect_timeout: 5s
upstream:
  backend: "tcp://127.0.0.1:25821"
EOF
}

process ptpt "env TPT_CONFIG=${tmpdir}/tpt.yaml ${tpt}" -start

shell {
    for i in $(seq 1 50); do
        nc -z 127.0.0.1 25820 2>/dev/null && exit 0
        sleep 0.2
    done
    echo "ERROR: tpt did not listen on 25820 in time" >&2
    exit 1
}

# Four connections: each should be closed by tpt after receiving the error.
# Covers http_connect() branches: 403, 502, 503, other (418).
shell {
    for label in 403 502 503 418; do
        python3 ${testdir}/helpers/expect_close.py 25820 0 5 || {
            echo "FAIL: [$label] tpt did not close the connection" >&2
            exit 1
        }
        sleep 0.05
    done
}

process ptpt -kill TERM
process ptpt -wait
process pbackend -kill TERM
process pbackend -wait
